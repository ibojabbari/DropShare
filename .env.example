# Required in every environment. Generate a unique, high-entropy value.
SECRET_KEY=replace-with-a-unique-secret-key

# development enables local debugging. Use production for deployed environments.
DJANGO_ENV=development

# Comma-separated hostnames; do not include a scheme or path.
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins including scheme and port.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# PostgreSQL connection settings
DB_NAME=dropshare
DB_USER=dropshare
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=127.0.0.1
DB_PORT=5432
